name = 'imkl'
version = '2021.4.0'

homepage = 'https://software.intel.com/content/www/us/en/develop/tools/oneapi/components/onemkl.html'
description = "Intel oneAPI Math Kernel Library"

toolchain = SYSTEM

# see https://software.intel.com/content/www/us/en/develop/articles/oneapi-standalone-components.html
source_urls = ['https://registrationcenter-download.intel.com/akdlm/IRC_NAS/18222/']
sources = ['l_onemkl_p_%(version)s.640_offline.sh']
checksums = ['9ad546f05a421b4f439e8557fd0f2d83d5e299b0d9bd84bdd86be6feba0c3915']

interfaces = False

postinstallcmds = [
  'gcc -shared -fPIC -o libmkl_serv_intel_cpu.so -xc - <<< "int mkl_serv_intel_cpu_true() {return 1;}"',
  'install libmkl_serv_intel_cpu.so %(installdir)s/libmkl_serv_intel_cpu.so',
]

modextravars = {
  'LD_PRELOAD': '%(installdir)s/libmkl_serv_intel_cpu.so',
}

moduleclass = 'numlib'
